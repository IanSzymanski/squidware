 climb","notes":"Four orbit conveyors join one by one; the guard well turns against them.","start":{"kind":"set","setId":"set-013"},"end":{"kind":"set","setId":"set-018"},"focus":{"kind":"all"}},{"id":"passage-7","name":"Battery orbit of three","notes":"Three battery circles, one full revolution, then back along the same lines.","start":{"kind":"set","setId":"set-021"},"end":{"kind":"set","setId":"set-025"},"focus":{"kind":"performers","performerIds":["snr-01","snr-02","snr-03","snr-04","snr-05","snr-06","snr-07","snr-08","snr-09","snr-10","ten-01","ten-02","ten-03","ten-04","ten-05","bas-01","bas-02","bas-03","bas-04","bas-05","cym-01","cym-02","cym-03","cym-04"]}},{"id":"passage-8","name":"Canon","notes":"Inner arc first, outer arcs one bar later.","start":{"kind":"set","setId":"set-029"},"end":{"kind":"set","setId":"set-030"},"focus":{"kind":"all"}},{"id":"passage-9","name":"Tether","notes":"Ballad: soloist, the cable, the chorus.","start":{"kind":"set","setId":"set-037"},"end":{"kind":"set","setId":"set-047"},"focus":{"kind":"all"}},{"id":"passage-10","name":"Rifle duet counter-march","notes":"The one deliberate finding in the show: see TE 5 notes.","start":{"kind":"set","setId":"set-040"},"end":{"kind":"set","setId":"set-041"},"focus":{"kind":"performers","performerIds":["rif-12","rif-11"]}},{"id":"passage-11","name":"Reentry","notes":"Closer: streaks, heat shield, impact, gears, company front.","start":{"kind":"set","setId":"set-048"},"end":{"kind":"set","setId":"set-067"},"focus":{"kind":"all"}},{"id":"passage-12","name":"Drumline feature","notes":"Battery assembles in the corridor while the streaks burn.","start":{"kind":"set","setId":"set-049"},"end":{"kind":"set","setId":"set-051"},"focus":{"kind":"section","sectionId":"sec-snr"}},{"id":"passage-13","name":"Company front","notes":"Gears to two full-width lines; release and hold.","start":{"kind":"set","setId":"set-064"},"end":{"kind":"set","setId":"set-067"},"focus":{"kind":"all"}}],"selectionGroups":[{"id