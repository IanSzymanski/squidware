{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/IanSzymanski/squidware/main/format/squid-v1.schema.json",
  "title": "Squidware project format v1",
  "description": "Structural validation. Also enforce FORMAT.md semantic constraints, UTF-16 text limits and the 10 MiB UTF-8 file limit. Unknown informational properties are accepted and discarded by the canonical reader.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/definitions/id"
    },
    "title": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
    },
    "ensemble": {
      "type": "string",
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
    },
    "field": {
      "type": "object",
      "properties": {
        "width": {
          "const": 100
        },
        "height": {
          "type": "number",
          "minimum": 53.33233333333334,
          "maximum": 53.33433333333333
        },
        "preset": {
          "enum": [
            "college",
            "high-school"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "preset"
      ]
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "performers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/performer"
      },
      "minItems": 0,
      "maxItems": 500
    },
    "sets": {
      "type": "array",
      "items": [
        {
          "allOf": [
            {
              "$ref": "#/definitions/picture"
            },
            {
              "properties": {
                "counts": {
                  "const": 0
                }
              }
            }
          ]
        }
      ],
      "minItems": 1,
      "maxItems": 128,
      "additionalItems": {
        "allOf": [
          {
            "$ref": "#/definitions/picture"
          },
          {
            "properties": {
              "counts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1024
              }
            }
          }
        ]
      }
    },
    "audioOffsetSeconds": {
      "type": "number",
      "minimum": -3600,
      "maximum": 3600
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "ensemble",
    "field",
    "sections",
    "performers",
    "sets",
    "audioOffsetSeconds"
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "enum": [
          "__proto__",
          "constructor",
          "prototype"
        ]
      }
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 53.333333333333336
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "required": [
        "id",
        "name",
        "color"
      ]
    },
    "performer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "label": {
          "type": "string",
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "sectionId": {
          "$ref": "#/definitions/id"
        }
      },
      "required": [
        "id",
        "label",
        "name",
        "sectionId"
      ]
    },
    "picture": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/definitions/id"
        },
        "name": {
          "type": "string",
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^(?=[\\s\\S]*\\S)[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "notes": {
          "type": "string",
          "maxLength": 10000,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]*$"
        },
        "positions": {
          "type": "object",
          "maxProperties": 500,
          "propertyNames": {
            "$ref": "#/definitions/id"
          },
          "additionalProperties": {
            "$ref": "#/definitions/point"
          }
        },
        "counts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "tempo": {
          "type": "number",
          "minimum": 20,
          "maximum": 400
        },
        "transition": {
          "enum": [
            "linear",
            "ease"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "notes",
        "positions",
        "counts",
        "tempo",
        "transition"
      ]
    }
  }
}
