{
  "name": "squidware",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A desktop drill design studio for marching ensembles",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop-dev.mjs",
    "start": "node scripts/build-project-codec.mjs && electron .",
    "build": "node scripts/build-project-codec.mjs && pnpm licenses:check && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win portable",
    "test:desktop": "node scripts/build-project-codec.mjs && node --test scripts/desktop.test.cjs scripts/preferences.test.cjs scripts/recovery.test.cjs",
    "test:recovery": "node scripts/recovery-qa.mjs",
    "test:editor": "node scripts/editor-qa.mjs",
    "test:accessibility": "node scripts/accessibility-qa.mjs",
    "test:tooltips": "node scripts/tooltip-qa.mjs",
    "test:preferences": "node scripts/preferences-qa.mjs",
    "test:thumbnails": "node scripts/thumbnail-qa.mjs",
    "test:3d": "node scripts/stage3d-qa.mjs",
    "perf:fixtures": "node scripts/performance-fixtures.mjs",
    "perf:compute": "node scripts/performance-compute.mjs",
    "perf:electron": "node scripts/performance-electron.mjs",
    "licenses:generate": "node scripts/generate-notices.mjs",
    "licenses:check": "node scripts/generate-notices.mjs --check",
    "format:generate": "node scripts/format-contract.mjs",
    "format:check": "node --test scripts/format-contract.test.mjs",
    "format:validate": "node scripts/validate-squid.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ajv": "8.17.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "studio.squidware.desktop",
    "productName": "Squidware",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "electron/recovery-*.cjs",
      "electron/project-codec.cjs"
    ],
    "beforePack": "./scripts/package-notices.mjs",
    "afterPack": "./scripts/verify-packaged-notices.mjs",
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "legal/LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "legal/THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "legal/LICENSES.chromium.html"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "public/icon512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "public/icon512.png"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "author": "Squidware contributors"
}
