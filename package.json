{
  "name": "squidware",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop drill design studio for marching ensembles",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/desktop-dev.mjs",
    "start": "electron .",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win portable",
    "test:desktop": "node --test scripts/desktop.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "studio.squidware.desktop",
    "productName": "Squidware",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music",
      "icon": "public/icon512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "public/icon512.png"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "author": "Squidware contributors"
}
